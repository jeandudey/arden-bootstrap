kind: exec

description: |
  bash 2.05b, built by make and tcc with the makefiles and the patches
  live-bootstrap ships, its parser generated by oyacc, and installed as bash
  and sh, with /bin a link to usr/bin so that /bin/sh is there.  A patch of
  our own makes set -e apply to subshells.

build-depends:
- bash/files.bst
- bash/source.bst
- coreutils/coreutils-0.bst
- live-bootstrap/source.bst
- make/make.bst
- oyacc/oyacc.bst
- patch/patch.bst
- sed/sed-0.bst
- stage0/catm.bst
- tcc/tcc.bst

variables:
  libdir: "%{prefix}/lib"
  lb-bash: "%{libdir}/live-bootstrap/bash-2.05b"

config:
  dirs:
  - "%{install-root}%{bindir}"
  commands:
  - cd: "%{libdir}/bash-src"
  - cp %{lb-bash}/mk/main.mk Makefile
  - cp %{lb-bash}/mk/builtins.mk builtins/Makefile
  - cp %{lb-bash}/mk/common.mk common.mk
  - touch config.h include/version.h include/pipesize.h
  - rm y.tab.c y.tab.h parser-built
  - patch -Np1 -i %{lb-bash}/patches/mes-libc.patch
  - patch -Np1 -i %{lb-bash}/patches/tinycc.patch
  - patch -Np1 -i %{lb-bash}/patches/missing-defines.patch
  - patch -Np1 -i %{lb-bash}/patches/locale.patch
  - patch -Np1 -i %{lb-bash}/patches/dev-tty.patch
  - patch -Np1 -i %{libdir}/bash-files/errexit-subshell.patch
  - make prefix=%{prefix} mkbuiltins
  - cd: builtins
  - make prefix=%{prefix} libbuiltins.a
  - cd: ..
  - make prefix=%{prefix}
  - install bash %{install-root}%{bindir}/bash
  - install bash %{install-root}%{bindir}/sh
  - ln -s usr/bin %{install-root}/bin
