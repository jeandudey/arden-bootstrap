kind: exec
(@): elements/mes/mes.yml

description: |
  nyacc's pregenerated C99 parser files, regenerated by mes-m2.

build-depends:
- stage0/chmod.bst
- stage0/cp.bst
- stage0/mkdir.bst
- stage0/rm.bst
- mes/sources.bst
- mes/config.bst
- nyacc/source.bst
- mes/mes-m2.bst

public:
  bst:
    overlap-whitelist:
    - "%{nyacc-prefix}/module/nyacc/lang/c99/mach.d/*"

config:
  commands:
  # Pregenerated, so that they are built from source.
  - rm %{mes-prefix}/mes/module/mes/psyntax.pp %{mes-prefix}/mes/module/mes/psyntax.pp.header
  - cd: "%{nyacc-prefix}"
  - rm module/nyacc/lang/c99/mach.d/c99-act.scm module/nyacc/lang/c99/mach.d/c99-tab.scm module/nyacc/lang/c99/mach.d/c99cx-act.scm module/nyacc/lang/c99/mach.d/c99cx-tab.scm module/nyacc/lang/c99/mach.d/c99x-act.scm module/nyacc/lang/c99/mach.d/c99x-tab.scm module/nyacc/lang/c99/mach.d/cpp-act.scm module/nyacc/lang/c99/mach.d/cpp-tab.scm
  - mes-m2 -L module gen-cpp-files.scm
  - set:
      MES_ARENA: "32000000"
  - mes-m2 -L module gen-c99-files.scm
  - set:
      MES_ARENA: "20000000"
  - mes-m2 -L module gen-c99cx-files.scm
  install:
  - from: "%{nyacc-prefix}/module/nyacc/lang/c99/mach.d"
    to: "%{nyacc-prefix}/module/nyacc/lang/c99/mach.d"
    files:
    - c99-act.scm
    - c99-tab.scm
    - c99cx-act.scm
    - c99cx-tab.scm
    - c99x-act.scm
    - c99x-tab.scm
    - cpp-act.scm
    - cpp-tab.scm
