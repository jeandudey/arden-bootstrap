kind: manual
(@): elements/gcc/tools.yml

description: |
  gcc 4.7.4, with C and C++, built by the gcc 4.0.4 that is built by itself,
  against musl 1.2.5, with the patches live-bootstrap has for musl and for the
  building of later gcc.  Everything in the tree that is generated is made
  again, and the libraries, the compiler and the C++ library are configured and
  built each in a directory of its own.

build-depends:
  (>):
  - autoconf/autoconf-2.64.bst
  - automake/automake-1.11.2.bst
  - bison/bison.bst
  - gmp/gmp.bst
  - live-bootstrap/source.bst
  - mpc/mpc.bst
  - mpfr/mpfr.bst
  - patch/patch.bst
  - zlib/zlib.bst

sources:
- kind: tar
  url: "kernel-mirror:gnu/gcc/gcc-4.7.4/gcc-4.7.4.tar.bz2"
  ref: 92e61c6dc3a0a449e62d72a38185fda550168a86702dea07125ebd3ec3996282

variables:
  lb-gcc: "%{libdir}/live-bootstrap/gcc-4.7.4"
  gcc-aclocal: AUTOCONF=autoconf-2.64 AUTOM4TE=autom4te-2.64 aclocal-1.11
  gcc-dirs: libiberty libcpp libdecnumber gcc libgcc libstdc++-v3

config:
  configure-commands:
  - |
    chmod -R u+w .
    for p in %{lb-gcc}/patches/*.patch; do patch -Np1 -i $p; done
    rm gcc/cp/cfns.h
    rm configure Makefile.in fixincludes/fixincl.x
    rm libgo/aclocal.m4 libgo/configure libgo/Makefile.in
    rm gcc/config/avr/t-multilib
    rm gcc/config/mep/intrinsics.h gcc/config/mep/intrinsics.md gcc/config/mep/mep-intrin.h
    rm gcc/config/arm/arm_neon.h
    rm gcc/testsuite/gcc.target/x86_64/abi/test_passing_integers.c \
      gcc/testsuite/gcc.target/x86_64/abi/test_3_element_struct_and_unions.c \
      gcc/testsuite/gcc.target/x86_64/abi/test_passing_floats.c \
      gcc/testsuite/gcc.target/x86_64/abi/test_basic_returning.c
    rm gcc/testsuite/go.test/test/bench/go1/jsondata_test.go \
      gcc/testsuite/go.test/test/bench/shootout/mandelbrot.txt
    rm gcc/testsuite/go.test/test/cmplxdivide1.go
    find zlib -name "*.obj" -delete
    rm zlib/contrib/puff/zeros.raw zlib/contrib/blast/test.pk zlib/contrib/dotzlib/DotZLib.chm
    find libjava -name "*.class" -delete
    find libjava -type f -name "*.jar" -delete
    find libjava -name "*.h" -exec grep -l "DO NOT EDIT THIS FILE" {} \; | xargs rm
    rm libjava/classpath/gnu/java/lang/CharData.java \
      libjava/classpath/gnu/java/rmi/dgc/DGCImpl_Skel.java \
      libjava/classpath/gnu/java/rmi/dgc/DGCImpl_Stub.java \
      libjava/classpath/gnu/java/rmi/registry/RegistryImpl_Skel.java \
      libjava/classpath/gnu/java/rmi/registry/RegistryImpl_Stub.java
    rm libjava/classpath/resource/gnu/java/locale/*.properties \
      libjava/classpath/resource/java/text/*.properties \
      libjava/classpath/resource/java/util/*.properties
    rm libjava/include/java-chardecomp.h libjava/include/java-chartables.h
    rm -r libjava/testsuite/libjava.cni libjava/testsuite/libjava.jvmti
    rm boehm-gc/MacProjects.sit.hqx
    find fixincludes/tests -name "*.h" -delete
    find . -name "*.pdf" -delete
    rm -r libstdc++-v3/doc/html
    rm libgfortran/generated/*.F90
    rm -r libgo/go/debug/elf/testdata libgo/go/debug/macho/testdata \
      libgo/go/debug/pe/testdata libgo/go/debug/dwarf/testdata
    rm libgo/go/regexp/syntax/perl_groups.go libgo/go/strconv/isprint.go
    rm libjava/sources.am libjava/Makefile.in
    rm libgcc/config/sh/lib1funcs.S libgcc/config/sh/lib1funcs-4-300.S
    rm libjava/classpath/java/util/TimeZone.java libjava/gcj/javaprims.h
    rm boehm-gc/cord/de_win.ICO
    for dir in intl libcpp libdecnumber; do
      (cd $dir
      rm aclocal.m4
      %{gcc-aclocal} --acdir=../config)
    done
    (cd gcc
    rm aclocal.m4
    %{gcc-aclocal} --acdir=../config)
    (cd fixincludes
    rm aclocal.m4
    %{gcc-aclocal} --acdir=../gcc)
    for dir in boehm-gc libffi libgfortran libgomp libitm libjava libmudflap libobjc libquadmath libssp lto-plugin zlib libjava/classpath libjava/libltdl; do
      (cd $dir
      rm aclocal.m4
      %{gcc-aclocal})
    done
    (cd libstdc++-v3
    ACLOCAL=aclocal-1.11 AUTOMAKE=automake-1.11 AUTOCONF=autoconf-2.64 AUTOM4TE=autom4te-2.64 autoreconf-2.64 -fi)
    for dir in $(find . -mindepth 2 -maxdepth 2 -name configure.ac | sed 's#/configure.ac##' | grep -v -x './libgo' | tr "\n" " " | sed -e 's/ $/\n/' -e 's/^boehm-gc //'); do
      (cd $dir
      rm configure
      autoconf-2.64 || autoconf-2.64)
    done
    for dir in $(find . -mindepth 2 -maxdepth 2 -name Makefile.am | sed 's#/Makefile.am##' | grep -v -x -e './libgo' -e './libjava' | tr "\n" " " | sed -e 's/ $/\n/' -e 's/^boehm-gc //'); do
      (cd $dir
      rm Makefile.in
      AUTOCONF=autoconf-2.64 AUTOM4TE=autom4te-2.64 automake-1.11 --add-missing)
    done
    for dir in libdecnumber libcpp libiberty gcc; do
      (cd $dir
      rm -f config.in
      autoheader-2.64)
    done
    (cd libiberty
    ./configure --enable-maintainer-mode
    make maint-deps)
    rm config.guess config.sub ltmain.sh
    rm libjava/libltdl/missing
    libtoolize -i
    rm -f config.sub
    cp %{prefix}/share/automake-1.15/config.sub .
    for dir in libjava/libltdl libjava/classpath libgo/config; do
      (cd $dir
      libtoolize -i)
    done
    rm intl/plural.c
    rm gcc/gengtype-lex.c
    (cd libiberty
    sed -n '/^   #include <stdio.h>/,/^   \}$/p' crc32.c > crcgen.c
    gcc -o crcgen crcgen.c
    sed '/crc_v3\.txt/{n; q}' crc32.c > crc32.c.new
    ./crcgen >> crc32.c.new
    sed '1,/^};$/d' crc32.c >> crc32.c.new
    mv crc32.c.new crc32.c)
    rm libdecnumber/decDPD.h
    gcc -std=c99 -o decDPD_generate %{lb-gcc}/files/decDPD_generate.c
    cp %{lb-gcc}/files/decDPD.h.preamble libdecnumber/decDPD.h
    ./decDPD_generate >> libdecnumber/decDPD.h
    find . -name '*.gmo' -delete
    rm libiberty/functions.texi
    find . -name '*.info' -delete
    find . -name '*.[1-9]' -delete
    mkdir build
    cd build
    for dir in %{gcc-dirs}; do
      mkdir $dir
      (cd $dir
      ../../$dir/configure \
        --prefix=%{prefix} --libdir=%{libdir} \
        --build=%{triple-musl} --target=%{triple-musl} --host=%{triple-musl} \
        --disable-shared --disable-multilib --program-transform-name= \
        --enable-languages=c,c++ --disable-sjlj-exceptions --with-system-zlib)
    done
  build-commands:
  - |
    ln -s . build/build-%{triple-musl}
    for dir in libiberty libcpp libdecnumber gcc; do
      make -C build/$dir LIBGCC2_INCLUDES=-I%{prefix}/include \
        STMP_FIXINC= GMPLIBS="-lmpc -lmpfr -lgmp" MAKEINFO=true
    done
    make -C build/libgcc PATH="$PATH:../gcc" CC=../gcc/xgcc \
      host_subdir=build CFLAGS="-I../gcc/include -I%{prefix}/include"
    make -C build/libstdc++-v3 PATH="$PATH:$PWD/build/gcc" \
      CXXFLAGS="-I$PWD/build/gcc/include -I %{prefix}/include"
  install-commands:
  - |
    make -C build/gcc install STMP_FIXINC= DESTDIR=%{install-root} MAKEINFO=true
    make -C build/libgcc install DESTDIR=%{install-root} host_subdir=build
    make -C build/libstdc++-v3 install DESTDIR=%{install-root}
    ln -s gcc %{install-root}%{bindir}/cc
    cp gcc/gsyslimits.h %{install-root}%{libdir}/gcc/%{triple-musl}/4.7.4/include/syslimits.h
    mkdir -p %{install-root}%{libdir}/gcc/%{triple-musl}/4.7.4/include
    mv %{install-root}%{libdir}/gcc/%{triple-musl}/4.0.4/include/* %{install-root}%{libdir}/gcc/%{triple-musl}/4.7.4/include/
    rmdir %{install-root}%{libdir}/gcc/%{triple-musl}/4.0.4/include
    mv %{install-root}%{libdir}/gcc/%{triple-musl}/4.0.4/* %{install-root}%{libdir}/gcc/%{triple-musl}/4.7.4/
