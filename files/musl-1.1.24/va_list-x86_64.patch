tcc has no __builtin_va_list on x86_64, which musl's va_list is, so musl takes the
va_list that tcc's libtcc1.a implements, with the builtins as macros over its
__va_start and __va_arg.  The type is defined once, as alltypes.h is read many
times.

--- a/arch/x86_64/bits/alltypes.h.in
+++ b/arch/x86_64/bits/alltypes.h.in
@@ -2,6 +2,30 @@
 #define _Int64 long
 #define _Reg long
 
+#ifdef __TINYC__
+#ifndef __TINYC_va_list
+#define __TINYC_va_list
+/* tcc passes the arguments in registers and has no __builtin_va_list: this is
+   the va_list its libtcc1.a implements.  */
+typedef struct {
+	unsigned int gp_offset;
+	unsigned int fp_offset;
+	union {
+		unsigned int overflow_offset;
+		char *overflow_arg_area;
+	};
+	char *reg_save_area;
+} __tinycc_va_list_struct;
+typedef __tinycc_va_list_struct __builtin_va_list[1];
+void __va_start(__tinycc_va_list_struct *, void *);
+void *__va_arg(__tinycc_va_list_struct *, int, int, int);
+#define __builtin_va_start(ap, last) __va_start(ap, __builtin_frame_address(0))
+#define __builtin_va_arg(ap, type) (*(type *)(__va_arg(ap, __builtin_va_arg_types(type), sizeof(type), __alignof__(type))))
+#define __builtin_va_copy(dest, src) (*(dest) = *(src))
+#define __builtin_va_end(ap)
+#endif
+#endif
+
 TYPEDEF __builtin_va_list va_list;
 TYPEDEF __builtin_va_list __isoc_va_list;
 
