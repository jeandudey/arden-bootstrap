tcc cannot find the registers for the inline assembly of a syscall with five
or six arguments, as musl writes it with register variables.  On tcc, make
those go through a function in assembly, __syscall_tcc, that moves the
arguments to where the kernel wants them.

--- a/arch/x86_64/syscall_arch.h
+++ b/arch/x86_64/syscall_arch.h
@@ -31,6 +31,26 @@
 	return ret;
 }
 
+#ifdef __TINYC__
+/* tcc cannot give inline assembly the registers these need, so they go
+   through __syscall_tcc, in src/internal/x86_64/syscall_tcc.s.  */
+long __syscall_tcc(long, long, long, long, long, long, long);
+
+static __inline long __syscall4(long n, long a1, long a2, long a3, long a4)
+{
+	return __syscall_tcc(n, a1, a2, a3, a4, 0, 0);
+}
+
+static __inline long __syscall5(long n, long a1, long a2, long a3, long a4, long a5)
+{
+	return __syscall_tcc(n, a1, a2, a3, a4, a5, 0);
+}
+
+static __inline long __syscall6(long n, long a1, long a2, long a3, long a4, long a5, long a6)
+{
+	return __syscall_tcc(n, a1, a2, a3, a4, a5, a6);
+}
+#else
 static __inline long __syscall4(long n, long a1, long a2, long a3, long a4)
 {
 	unsigned long ret;
@@ -60,6 +80,7 @@
 						  "d"(a3), "r"(r10), "r"(r8), "r"(r9) : "rcx", "r11", "memory");
 	return ret;
 }
+#endif
 
 #define VDSO_USEFUL
 #define VDSO_CGT_SYM "__vdso_clock_gettime"
--- a/src/internal/x86_64/syscall_tcc.s
+++ b/src/internal/x86_64/syscall_tcc.s
@@ -0,0 +1,16 @@
+# long __syscall_tcc(long n, long a1, long a2, long a3, long a4, long a5, long a6)
+# The arguments are in rdi, rsi, rdx, rcx, r8, r9 and on the stack; the kernel
+# wants the number in rax and the arguments in rdi, rsi, rdx, r10, r8, r9.
+.global __syscall_tcc
+.hidden __syscall_tcc
+.type __syscall_tcc,@function
+__syscall_tcc:
+	mov %rdi,%rax
+	mov %rsi,%rdi
+	mov %rdx,%rsi
+	mov %rcx,%rdx
+	mov %r8,%r10
+	mov %r9,%r8
+	mov 8(%rsp),%r9
+	syscall
+	ret
