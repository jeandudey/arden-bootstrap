tcc stops at 'static', 'const', 'volatile' and '*' inside the brackets of an
array parameter, as in char buf[static 15], which musl uses.  Skip them, as
live-bootstrap's patch to tcc 0.9.27 does; they only matter to an optimiser.

--- a/tccgen.c
+++ b/tccgen.c
@@ -4154,8 +4154,23 @@
 	int saved_nocode_wanted = nocode_wanted;
         /* array definition */
         next();
-        if (tok == TOK_RESTRICT1)
-            next();
+	while (1) {
+	    /* XXX The optional type-quals and static should only be accepted
+	       in parameter decls.  The '*' as well, and then even only
+	       in prototypes (not function defs).  */
+	    switch (tok) {
+	    case TOK_RESTRICT1: case TOK_RESTRICT2: case TOK_RESTRICT3:
+	    case TOK_CONST1:
+	    case TOK_VOLATILE1:
+	    case TOK_STATIC:
+	    case '*':
+		next();
+		continue;
+	    default:
+		break;
+	    }
+	    break;
+	}
         n = -1;
         t1 = 0;
         if (tok != ']') {
